# Maintainer: John Sohn <john.sohn@gmail.com>
pkgname=a78tool
pkgver=0.1.0
pkgrel=1
pkgdesc="Atari 7800 .a78 ROM header utility adhering to the 8BitDev specification"
arch=('x86_64' 'aarch64')
url="https://github.com/username/lokey-7800-tools"
license=('MIT')
depends=('gcc-libs')
makedepends=('cargo')

build() {
  cargo build --release --locked --workspace
}

package() {
  install -Dm755 "$srcdir/../target/release/a78tool" "$pkgdir/usr/bin/a78tool"
  install -Dm644 "$srcdir/../README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$srcdir/../LICENSE" "$pkgdir/usr/share/doc/$pkgname/LICENSE"
}
