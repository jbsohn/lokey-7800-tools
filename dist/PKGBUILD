# Maintainer: John Sohn <john.sohn@gmail.com>
pkgname=rom2a78
pkgver=0.1.0
pkgrel=1
pkgdesc="Atari 7800 .a78 ROM header utility adhering to the 8BitDev specification"
arch=('x86_64' 'aarch64')
url="https://github.com/username/lokey-7800-tools"
license=('MIT')
depends=('gcc-libs')
makedepends=('cargo')

build() {
  cargo build --release --locked --workspace
}

package() {
  install -Dm755 "target/release/rom2a78" "$pkgdir/usr/bin/rom2a78"
  install -Dm644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
